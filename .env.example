# Copy to .env.local. One file configures both the web app and the /api/v1 route handlers.

# Public values (exposed to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
# SUPABASE_URL / SUPABASE_ANON_KEY default to the public values above when left blank.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-documents

# Hosted model provider settings. Endpoints must use HTTPS (localhost is allowed) and accept
# OpenAI-compatible embeddings and chat-completions JSON. No provider or secret is preselected.
AI_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_ENDPOINT=
AI_CHAT_REASONING_EFFORT=none
AI_EMBEDDING_MODEL=
AI_EMBEDDING_ENDPOINT=
RAG_MIN_SIMILARITY=0.70
# Passages sent to the answer model: at most RAG_MAX_CHUNKS, and only those scoring within
# RAG_RELEVANCE_MARGIN of the best match. Fewer passages = a shorter prompt = a faster answer.
RAG_MAX_CHUNKS=4
RAG_RELEVANCE_MARGIN=0.10
# Ollama only: keep models loaded between questions and warm them up when the server starts
# (e.g. 1h). Leave blank for hosted providers, which reject this field.
AI_KEEP_ALIVE=

# When true (default), the Next.js server indexes uploaded documents right after the upload
# response is sent. Set to false if you run `npm run worker` as a separate process instead.
INGESTION_INLINE=true
