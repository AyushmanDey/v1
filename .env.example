# Frontend (public values only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend. Keep secrets server-side; never use NEXT_PUBLIC_ for these values.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=course-documents

# Hosted model provider settings. The current worker expects an OpenAI-compatible
# embeddings endpoint and response format; no provider or secret is preselected.
AI_PROVIDER=
AI_API_KEY=
AI_CHAT_MODEL=
AI_CHAT_ENDPOINT=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_ENDPOINT=
RAG_MIN_SIMILARITY=0.70
RAG_MAX_CHUNKS=8



AI_CHAT_REASONING_EFFORT=none

